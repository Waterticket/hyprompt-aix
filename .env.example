# Copy to .env and enter your Kakao JavaScript key.
# This key is rendered into browser HTML; restrict allowed SDK domains in Kakao Developers.
KAKAO_MAP_JAVASCRIPT_KEY=
# Local fixtures supply battery, recall and center records.
DATA_MODE=local_fixture
APP_TIMEZONE=Asia/Seoul
# Docker host address and port (use 127.0.0.1 behind a local reverse proxy).
KICKLOG_BIND_HOST=0.0.0.0
KICKLOG_PORT=5000
# Optional; if omitted, a signing key is generated and persisted in the volume.
# SECRET_KEY=replace-with-a-long-random-value
